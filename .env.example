# ─────────────────────────────────────────────────────────────────────────────
#  Jager configuration. Copy to .env and fill in the blanks. Never commit .env.
#  Every variable is documented in docs/CONFIGURATION.md.
# ─────────────────────────────────────────────────────────────────────────────

# Key 1 of 3 (required): Zernio connects your social accounts and your chat app.
# Create it at https://zernio.com/dashboard/api-keys
ZERNIO_API_KEY=

# Any long random string. Zernio signs every webhook with it, Jager verifies it.
# Generate one with:  openssl rand -hex 32
ZERNIO_WEBHOOK_SECRET=

# Only this person can command Jager. A phone number (+351912345678),
# a Telegram id or a Telegram username. Leave it empty and Jager ignores everybody.
JAGER_OWNER_ID=

# Key 2 of 3 (optional): the AI brain. Without it Jager still works from rules.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
JAGER_FALLBACK_MODELS=google/gemini-2.0-flash-001
JAGER_DAILY_BUDGET_USD=0.50

# Key 3 of 3 (optional): reserved for image jobs.
RUNWARE_API_KEY=

# Your world
JAGER_CHANNEL=telegram          # telegram | whatsapp
JAGER_TIMEZONE=Europe/Lisbon
JAGER_LANGUAGE=en               # en | fr
JAGER_RECAP=sunday 10:00        # weekly reminder, in your timezone
JAGER_QUIET_HOURS=23:00-08:00   # no proactive messages in this window

# SAFE BY DEFAULT. While true, Jager pretends to delete and tells you so.
# Flip to false deliberately, after you have watched him behave.
JAGER_DRY_RUN=true

# Plumbing (rarely needed)
# JAGER_HOST=127.0.0.1          # the Docker image sets 0.0.0.0 internally
# PORT=8080
# JAGER_DB=data/jager.db
